<% result_path = leaf.book.editable? ? edit_leafable_path(leaf) : leafable_slug_path(leaf, search: params[:search]) %>
<%= link_to result_path, class: "search__result txt-ink", data: { turbo_frame: "_top" } do %>
  <strong><%= sanitize_search_result(leaf.title_match) %>:</strong> <%= sanitize_search_result(leaf.content_match) %>
<% end %>
